---
import type { GetStaticPaths } from 'astro';
import MainLayout from '../layouts/MainLayout.astro';

export const getStaticPaths = (() => {
  return [
    { params: { name: 'bulbasaur' }, props: { name: 'bulbasaur', url: 'https://pokeapi.co/api/v2/pokemon/1/' } },
    { params: { name: 'charmander' }, props: { name: 'charmander', url: 'https://pokeapi.co/api/v2/pokemon/4/' } },
  ];
}) satisfies GetStaticPaths;

const { name } = Astro.params;
const { url } = Astro.props;
---

<MainLayout title="Algún pokémon">
  <section class="mt-10 mx-10 flex flex-col justify-center items-center">
    <div>
      <a href="/">Regresar</a>
      <h1 class="text-3xl capitalize">{name}</h1>
    </div>

    <div class="mt-6 w-full max-w-md rounded-xl border border-slate-300 bg-slate-50 p-6 shadow-sm">
      <p class="text-lg font-semibold capitalize">{name}</p>
      <p class="mt-2 text-sm text-slate-600">URL: {url}</p>
    </div>
  </section>
</MainLayout>